# ——— Multi-tenant sale mode (Vercel / public host) ———
# On Vercel tenant mode is ON automatically (each login → own empty cabinet).
# Admin key to open /admin once and issue customer logins (visible only to you)
MINDOS_ADMIN_SECRET=
# Signs customer session cookies (falls back to ADMIN / API secret if empty)
MINDOS_SESSION_SECRET=
# Your product-owner login on the main form (default: owner). Create password in /admin → «Мой вход»
# MINDOS_OWNER_LOGIN=owner
# Optional bootstrap password if creating owner via ensureOwner without UI password
# MINDOS_OWNER_PASSWORD=
# Optional: force tenant mode on a non-Vercel host
# MINDOS_MULTI_TENANT=1
# Force cloud as source of truth (Vercel sets this via VERCEL=1)
# MINDOS_CLOUD_PRIMARY=1

# Legacy single shared key (local / transitional). Not used for customer logins in tenant mode.
MINDOS_API_SECRET=

# Local Oracle (optional)
ANTHROPIC_API_KEY=

# Supabase — Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://dfrzbrgttlsdwyifbwfc.supabase.co

# New keys (publishable / secret) — preferred
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy aliases (same values work for older clients)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres (Dashboard → Project Settings → Database → Connection string)
# Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.dfrzbrgttlsdwyifbwfc.supabase.co:5432/postgres

# Optional: override Finder vault (default ~/Documents/2MindOS)
# MINDOS_DATA_DIR=/Users/you/Documents/2MindOS

# Local-first (default on): skip cloud pull at boot so vault is never wiped by a richer revision
MINDOS_SKIP_CLOUD_PULL=1
